---
import type { ExperienceItem } from "../types";

export interface Props {
  achievements: ExperienceItem[];
}

const { achievements } = Astro.props;
---

<section id="achievements" class="section-padding">
  <div class="container">
    <h2 class="section-title mono"><span class="text-accent">05.</span> Honors & Awards</h2>
    
    <div class="achievements-grid">
      {achievements.map((item) => (
        <div class="achievement-card">
          <div class="card-header">
            <h3 class="award-title text-accent">{item.company}</h3>
            <span class="prize-tag mono">{item.endDate}</span>
          </div>
          <h4 class="role-title">{item.position}</h4>
          <ul class="details-list">
            {item.summary.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-padding {
    padding: var(--space-xl) 0;
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  .achievement-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-border);
    padding: var(--space-md);
    border-radius: 8px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .achievement-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-accent);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.5rem;
    gap: 1rem;
  }

  .award-title {
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .prize-tag {
    font-size: 0.85rem;
    color: var(--color-accent);
    white-space: nowrap;
    background: rgba(0, 255, 163, 0.1);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .role-title {
    font-size: 0.95rem;
    color: var(--color-text-main);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .details-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .details-list li {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    line-height: 1.5;
    position: relative;
    padding-left: 1.2rem;
  }

  .details-list li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
</style>

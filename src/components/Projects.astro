---
import type { Project } from "../types";
import { rich } from "../utils/rich";
import Arrow from "../icons/Arrow.astro";

export interface Props {
  projects: Project[];
  more: string;
}

const { projects, more } = Astro.props;
---

<div class="projects">
  {projects.map((project) => (
    <article class="project">
      <!-- Each project shows something: a screenshot, or failing that its headline figure -->
      <a href={project.live ?? project.source} target="_blank" rel="noopener noreferrer" class="panel project-figure" tabindex="-1" aria-hidden="true">
        {project.video ? (
          // started by the script below once it scrolls into view
          <video poster={project.image} muted loop playsinline preload="none" data-inview-play>
            {project.video.map((src) => <source src={src} type={`video/${src.split(".").pop()}`} />)}
          </video>
        ) : project.image ? (
          <img src={project.image} alt="" loading="lazy" decoding="async" />
        ) : project.figure && (
          <span class="project-stat">
            <span class="project-stat-value mono">{project.figure.value}</span>
            <span class="project-stat-label">{project.figure.label}</span>
          </span>
        )}
      </a>

      <div class="project-body">
        <div class="project-top">
          <h3 class="project-name">{project.name}</h3>
          <p class="project-links">
            <a href={project.source} target="_blank" rel="noopener noreferrer" class="out">Source<Arrow /></a>
            {project.live && (
              <a href={project.live} target="_blank" rel="noopener noreferrer" class="out">Live demo<Arrow /></a>
            )}
          </p>
        </div>
        <p class="project-stack mono">{project.stack.join(" · ")}</p>
        <p class="project-summary" set:html={rich(project.summary)} />
      </div>
    </article>
  ))}
</div>

<p class="more" set:html={rich(more)} />

<script>
  // Videos play only while on screen, and not at all for readers who ask for reduced motion
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-inview-play]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  if (videos.length > 0 && !still.matches) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => { /* autoplay refused: the poster stays */ });
        else video.pause();
      }
    }, { threshold: 0.25 });
    videos.forEach((video) => observer.observe(video));
  }
</script>

<style>
  .project {
    display: grid;
    grid-template-columns: 19rem minmax(0, 1fr);
    gap: 1.25rem 2.25rem;
    align-items: start;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }

  .project:first-child {
    padding-top: 0;
    border-top: none;
  }

  .project-figure {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .project:hover .project-figure {
    border-color: var(--color-border-strong);
  }

  .project-figure img,
  .project-figure video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project:hover .project-figure img,
  .project:hover .project-figure video {
    transform: scale(1.03);
  }

  .project-stat {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    height: 100%;
    padding: 1.1rem 1.2rem;
  }

  .project-stat-value {
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .project-stat-label {
    font-size: var(--text-tiny);
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .project-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1.5rem;
  }

  .project-name {
    font-size: 1.25rem;
  }

  .project-links {
    display: flex;
    gap: 1.25rem;
  }

  .project-stack {
    margin: 0.4rem 0 0.8rem;
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  .project-summary {
    max-width: 40rem;
    color: var(--color-text-muted);
  }

  .more {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 700px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
    }

    /* a figure tile needs less height than a screenshot once it spans the column */
    .project-figure:has(.project-stat) {
      aspect-ratio: 5 / 2;
    }
  }
</style>

---
import type { OwnProject } from "../types";
import { rich } from "../utils/rich";
import { repoFacts } from "../utils/github";
import data from "../data/poolproof.json";
import Arrow from "../icons/Arrow.astro";
import Matrix from "./Matrix.astro";

export interface Props {
  project: OwnProject;
}

const { project } = Astro.props;

// "https://github.com/owner/name" -> "owner/name"
const facts = await repoFacts(new URL(project.repo).pathname.slice(1), data.repo);
const day = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<article class="own">
  <div class="own-intro">
    <div>
      <h3 class="own-name mono">{project.name}</h3>
      <p class="own-tagline">{project.tagline}</p>
      <p class="own-links">
        <a href={project.repo} target="_blank" rel="noopener noreferrer" class="out">Source<Arrow /></a>
        <a href={project.results} target="_blank" rel="noopener noreferrer" class="out">Results<Arrow /></a>
        <span class="mono text-faint">{project.stack}</span>
      </p>
      {project.caseStudy?.status === "published" && (
        <p class="own-story"><a href={project.caseStudy.href} class="link">Read how it was built</a></p>
      )}
      {project.caseStudy?.status === "in-progress" && (
        <p class="own-story text-faint">Case study in progress</p>
      )}
      <!-- looked up from GitHub when the site was built -->
      <p class="own-facts mono">
        <span>{facts.release}</span>
        <span>released {day(facts.releasedAt)}</span>
        <span>last push {day(facts.pushedAt)}</span>
      </p>
    </div>
    <p class="own-summary" set:html={rich(project.summary)} />
  </div>

  <Matrix />

  <ul class="own-points">
    {project.points.map((point) => <li set:html={rich(point)} />)}
  </ul>
</article>

<style>
  .own {
    display: grid;
    gap: 2.5rem;
  }

  .own-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1.25rem 3rem;
    align-items: start;
  }

  .own-name {
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .own-tagline {
    margin: 0.5rem 0 1.1rem;
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .own-summary {
    color: var(--color-text-muted);
  }

  .own-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.4rem;
    font-size: var(--text-tiny);
  }

  .own-story {
    margin-top: 0.9rem;
    font-size: var(--text-small);
  }

  .own-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0;
    margin-top: 0.9rem;
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--color-text-faint);
  }

  .own-facts span + span::before {
    content: "·";
    margin-inline: 0.5em;
  }

  /* ── Points: two balanced columns ────────────── */
  .own-points {
    columns: 2;
    column-gap: 3rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .own-points li {
    break-inside: avoid;
    padding: 0.95rem 0;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 760px) {
    .own-intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .own-points {
      columns: 1;
    }
  }
</style>

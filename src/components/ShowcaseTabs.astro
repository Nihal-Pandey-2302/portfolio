---
import Projects from "./Projects.astro";
import Experience from "./Experience.astro";
import Achievements from "./Achievements.astro";
import Writing from "./Writing.astro";
import type { SiteContent } from "../types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;

// Single source of truth for the tab set: buttons, panels, and ARIA ids
// all render from this array; the script derives its hash list from data-tab.
const TABS: { id: string; label: string; Panel: any; props: Record<string, any> }[] = [
  { id: "projects", label: "Featured Projects", Panel: Projects, props: { projects: content.projects, hideTitle: true } },
  { id: "experience", label: "Experience", Panel: Experience, props: { experience: content.experience, hideTitle: true } },
  { id: "awards", label: "Honors & Awards", Panel: Achievements, props: { achievements: content.achievements, hideTitle: true } },
  { id: "writing", label: "Technical Writing", Panel: Writing, props: { writing: content.writing, hideTitle: true } },
];
---

<section id="showcase" class="section-padding">
  <div class="container">
    <div class="tabs-header mb-sm">
      <div class="tabs-scroller" role="tablist" aria-label="Showcase sections">
        {TABS.map((t, i) => (
          <button
            class:list={["tab-btn", "mono", { active: i === 0 }]}
            data-tab={t.id}
            id={`tab-btn-${t.id}`}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`tab-${t.id}`}
            tabindex={i === 0 ? undefined : -1}
          >
            {t.label}
          </button>
        ))}
        <div class="tab-indicator"></div>
      </div>
    </div>

    {TABS.map((t, i) => (
      <div
        class:list={["tab-content", { active: i === 0 }]}
        id={`tab-${t.id}`}
        role="tabpanel"
        aria-labelledby={`tab-btn-${t.id}`}
      >
        <t.Panel {...t.props} />
      </div>
    ))}
  </div>
</section>

<script>
  function setupTabs() {
    const tablist = document.querySelector('.tabs-scroller') as HTMLElement | null;
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('.tab-btn'));
    const contents = document.querySelectorAll('.tab-content');
    const indicator = document.querySelector('.tab-indicator') as HTMLElement;
    const TAB_IDS = tabs.map(t => t.dataset.tab!);
    // The awards tab wraps <section id="achievements">, so accept that hash too
    const HASH_ALIASES: Record<string, string> = { achievements: 'awards' };

    const scrollBehavior = (): ScrollBehavior =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    function moveIndicator(element: HTMLElement) {
      if (!indicator) return;
      indicator.style.width = `${element.offsetWidth}px`;
      indicator.style.left = `${element.offsetLeft}px`;
    }

    function switchTab(tabId: string) {
      const tabBtn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`) as HTMLElement;
      if (!tabBtn) return;

      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
        t.setAttribute('tabindex', '-1');
      });
      contents.forEach(c => c.classList.remove('active'));

      tabBtn.classList.add('active');
      tabBtn.setAttribute('aria-selected', 'true');
      tabBtn.removeAttribute('tabindex');
      moveIndicator(tabBtn);

      document.getElementById(`tab-${tabId}`)?.classList.add('active');
    }

    // Indicator: initialize, and re-query the CURRENT active tab on resize
    const initialTab = document.querySelector('.tab-btn.active') as HTMLElement;
    if (initialTab) requestAnimationFrame(() => moveIndicator(initialTab));
    window.addEventListener('resize', () => {
      const current = document.querySelector('.tab-btn.active') as HTMLElement;
      if (current) moveIndicator(current);
    });

    // Tab button clicks
    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        const tabId = (e.currentTarget as HTMLElement).getAttribute('data-tab');
        if (tabId) switchTab(tabId);
      });
    });

    // Arrow-key navigation, delegated to the tablist (roving tabindex)
    tablist?.addEventListener('keydown', (e) => {
      const target = (e.target as HTMLElement).closest('.tab-btn') as HTMLElement | null;
      if (!target) return;
      const i = tabs.indexOf(target);
      let next = -1;
      if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next === -1) return;
      e.preventDefault();
      const tabId = tabs[next].dataset.tab;
      if (tabId) switchTab(tabId);
      tabs[next].focus();
    });

    function activateFromHash(hash: string) {
      const tabId = HASH_ALIASES[hash] ?? hash;
      if (!TAB_IDS.includes(tabId)) return;
      switchTab(tabId);
      document.getElementById('showcase')?.scrollIntoView({ behavior: scrollBehavior() });
    }

    function handleHash() {
      activateFromHash(window.location.hash.slice(1));
    }

    // On load, and on hash traversal (back/forward, external hash changes)
    handleHash();
    window.addEventListener('hashchange', handleHash);

    // In-page nav clicks: preventDefault + pushState so exactly one scroll runs
    // (covers same-hash re-clicks, which fire no hashchange, and stops the
    // native fragment jump racing our scroll). Modified clicks pass through.
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const anchor = (e.target as Element).closest?.('a[href*="#"]') as HTMLAnchorElement | null;
      if (!anchor || anchor.target === '_blank') return;
      const url = new URL(anchor.href, window.location.href);
      if (url.origin !== window.location.origin || url.pathname !== window.location.pathname) return;
      const hash = url.hash.slice(1);
      if (!TAB_IDS.includes(HASH_ALIASES[hash] ?? hash)) return;
      e.preventDefault();
      if (window.location.hash !== url.hash) history.pushState(null, '', url.hash);
      activateFromHash(hash);
    });

    // Edge fade while the tab strip has more content to the right
    if (tablist) {
      const updateFade = () => {
        tablist.classList.toggle(
          'has-overflow-right',
          tablist.scrollLeft + tablist.clientWidth < tablist.scrollWidth - 4
        );
      };
      tablist.addEventListener('scroll', updateFade, { passive: true });
      window.addEventListener('resize', updateFade);
      updateFade();
    }
  }

  setupTabs();
  document.addEventListener('astro:page-load', setupTabs);
</script>

<style>
  .section-padding {
    padding: var(--space-xl) 0;
  }

  #showcase {
    scroll-margin-top: var(--header-height);
  }

  .tabs-header {
    display: flex;
    justify-content: center;
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }

  .tabs-scroller {
    display: flex;
    gap: var(--space-lg);
    position: relative;
    padding-bottom: 0px; /* Aligns indicator with border */
    max-width: 100vw; /* Prevent overflow */
    overflow-x: auto; /* Allow internal scrolling */
    scrollbar-width: none; /* Hide scrollbar */
  }

  .tabs-scroller::-webkit-scrollbar {
    display: none;
  }

  /* Hint that more tabs exist past the right edge */
  .tabs-scroller.has-overflow-right {
    -webkit-mask-image: linear-gradient(to right, black calc(100% - 48px), transparent);
    mask-image: linear-gradient(to right, black calc(100% - 48px), transparent);
  }

  .tab-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.85rem 0.5rem;
    transition: color 0.3s ease;
    opacity: 0.7;
    letter-spacing: 0;
  }

  .tab-btn:hover {
    opacity: 1;
    color: var(--color-text-main);
  }

  .tab-btn.active {
    color: var(--color-accent);
    opacity: 1;
    font-weight: 600;
  }

  .tab-indicator {
    position: absolute;
    bottom: -1px; /* Overlaps border-bottom */
    height: 2px;
    background: var(--color-accent);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 -2px 10px rgba(var(--color-accent-rgb), 0.5);
  }

  .tab-content {
    display: none;
    opacity: 0;
    padding-top: var(--space-md); /* Reduced from space-lg */
  }

  .tab-content.active {
    display: block;
    opacity: 1;
    animation: fadeIn 0.4s ease forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .tabs-scroller {
      gap: var(--space-md);
      width: 100%;
      justify-content: space-between;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .tab-btn {
      font-size: 1rem;
      white-space: nowrap;
    }

    .tabs-header {
      justify-content: flex-start;
    }
  }
</style>

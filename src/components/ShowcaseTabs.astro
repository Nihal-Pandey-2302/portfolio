---
import Projects from "./Projects.astro";
import Experience from "./Experience.astro";
import Achievements from "./Achievements.astro";
import type { SiteContent } from "../types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="showcase" class="section-padding">
  <div class="container">
    <div class="tabs-nav flex justify-center gap-md mb-lg">
      <button class="tab-btn active" data-tab="projects">Featured Projects</button>
      <button class="tab-btn" data-tab="experience">Experience</button>
      <button class="tab-btn" data-tab="awards">Honors & Awards</button>
    </div>

    <div class="tab-content active" id="tab-projects">
      <Projects projects={content.projects} />
    </div>

    <div class="tab-content" id="tab-experience">
      <Experience experience={content.experience} />
    </div>

    <div class="tab-content" id="tab-awards">
      <Achievements achievements={content.achievements} />
    </div>
  </div>
</section>

<script>
  function setupTabs() {
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // Remove active class from all tabs
        tabs.forEach(t => t.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));

        // Add active class to clicked tab
        tab.classList.add('active');

        // Show corresponding content
        const targetId = `tab-${tab.getAttribute('data-tab')}`;
        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.classList.add('active');
          // Trigger any entrance animations if needed
          const animatedElements = targetContent.querySelectorAll('.animate-on-scroll');
          animatedElements.forEach(el => {
             el.classList.remove('visible');
             void (el as HTMLElement).offsetWidth; // Trigger reflow
             el.classList.add('visible');
          });
        }
      });
    });
  }

  // Setup on page load
  setupTabs();

  // Setup on view transitions if enabled
  document.addEventListener('astro:page-load', setupTabs);
</script>

<style>
  .section-padding {
    padding: var(--space-lg) 0;
  }

  .tabs-nav {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
    position: sticky;
    top: calc(var(--header-height) + 1rem); /* Sticky below header */
    z-index: 90;
    background: rgba(10, 10, 10, 0.8);
    backdrop-filter: blur(10px);
    margin: 0 auto var(--space-xl);
    max-width: 800px;
  }

  .tab-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.5rem 1rem;
    position: relative;
    transition: all 0.3s ease;
  }

  .tab-btn:hover {
    color: var(--color-text-main);
  }

  .tab-btn.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: -1.1rem; /* Align with border-bottom of container */
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-accent);
    box-shadow: 0 -2px 10px var(--color-accent);
  }

  .tab-content {
    display: none;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .tab-content.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
    animation: fadeIn 0.5s ease forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 600px) {
    .tabs-nav {
      flex-direction: column;
      gap: 0.5rem;
      border-bottom: none;
      align-items: center;
    }

    .tab-btn {
      width: 100%;
      border-bottom: 1px solid var(--color-border);
      padding: 0.8rem;
    }

    .tab-btn.active::after {
      bottom: 0;
    }
  }
</style>

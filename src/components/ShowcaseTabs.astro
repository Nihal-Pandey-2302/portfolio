---
import Projects from "./Projects.astro";
import Experience from "./Experience.astro";
import Achievements from "./Achievements.astro";
import Writing from "./Writing.astro";
import type { SiteContent } from "../types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="showcase" class="section-padding">
  <div class="container">
    <div class="tabs-header mb-sm">
      <div class="tabs-scroller">
        <button class="tab-btn active mono" data-tab="projects">Featured Projects</button>
        <button class="tab-btn mono" data-tab="experience">Experience</button>
        <button class="tab-btn mono" data-tab="awards">Honors & Awards</button>
        <button class="tab-btn mono" data-tab="writing">Technical Writing</button>
        <div class="tab-indicator"></div>
      </div>
    </div>

    <div class="tab-content active" id="tab-projects">
      <Projects projects={content.projects} hideTitle={true} />
    </div>

    <div class="tab-content" id="tab-experience">
      <Experience experience={content.experience} hideTitle={true} />
    </div>

    <div class="tab-content" id="tab-awards">
      <Achievements achievements={content.achievements} hideTitle={true} />
    </div>

    <div class="tab-content" id="tab-writing">
      <Writing writing={content.writing} hideTitle={true} />
    </div>
  </div>
</section>

<script>
  function setupTabs() {
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');
    const indicator = document.querySelector('.tab-indicator') as HTMLElement;

    function moveIndicator(element: HTMLElement) {
      if (!indicator) return;
      indicator.style.width = `${element.offsetWidth}px`;
      indicator.style.left = `${element.offsetLeft}px`;
    }

    function switchTab(tabId: string) {
      const tabBtn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`) as HTMLElement;
      if (!tabBtn) return;

      // Remove active class from all tabs
      tabs.forEach(t => t.classList.remove('active'));
      contents.forEach(c => c.classList.remove('active'));

      // Add active class to target tab
      tabBtn.classList.add('active');
      moveIndicator(tabBtn);

      // Show corresponding content
      const targetContent = document.getElementById(`tab-${tabId}`);
      if (targetContent) {
        targetContent.classList.add('active');
        // Trigger animations
        const animatedElements = targetContent.querySelectorAll('.animate-on-scroll');
        animatedElements.forEach(el => {
           el.classList.remove('visible');
           void (el as HTMLElement).offsetWidth; 
           el.classList.add('visible');
        });
      }
    }

    // Initialize indicator position
    const activeTab = document.querySelector('.tab-btn.active') as HTMLElement;
    if (activeTab) {
      requestAnimationFrame(() => moveIndicator(activeTab));
      window.addEventListener('resize', () => moveIndicator(activeTab));
    }

    // Handle Clicks
    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const tabId = target.getAttribute('data-tab');
        if (tabId) switchTab(tabId);
      });
    });

    // Handle Hash Navigation
    function handleHash() {
      const hash = window.location.hash.slice(1); // remove #
      if (['projects', 'experience', 'awards', 'writing'].includes(hash)) {
        switchTab(hash);
        // Scroll to showcase section
        const showcase = document.getElementById('showcase');
        if (showcase) {
          showcase.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }

    // Check hash on load and change
    handleHash();
    window.addEventListener('hashchange', handleHash);
  }

  setupTabs();
  document.addEventListener('astro:page-load', setupTabs);
</script>

<style>
  .section-padding {
    padding: var(--space-xl) 0;
  }

  .tabs-header {
    display: flex;
    justify-content: center;
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }

  .tabs-scroller {
    display: flex;
    gap: var(--space-lg);
    position: relative;
    padding-bottom: 0px; /* Aligns indicator with border */
    max-width: 100vw; /* Prevent overflow */
    overflow-x: auto; /* Allow internal scrolling */
    scrollbar-width: none; /* Hide scrollbar */
  }
  
  .tabs-scroller::-webkit-scrollbar {
    display: none;
  }

  .tab-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.85rem 0.5rem;
    transition: color 0.3s ease;
    opacity: 0.7;
    letter-spacing: 0;
  }

  .tab-btn:hover {
    opacity: 1;
    color: var(--color-text-main);
  }

  .tab-btn.active {
    color: var(--color-accent);
    opacity: 1;
    font-weight: 600;
  }

  .tab-indicator {
    position: absolute;
    bottom: -1px; /* Overlaps border-bottom */
    height: 2px;
    background: var(--color-accent);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 -2px 10px rgba(52, 211, 153, 0.5);
  }

  .tab-content {
    display: none;
    opacity: 0;
    padding-top: var(--space-md); /* Reduced from space-lg */
  }

  .tab-content.active {
    display: block;
    opacity: 1;
    animation: fadeIn 0.4s ease forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .tabs-scroller {
      gap: var(--space-md);
      width: 100%;
      justify-content: space-between;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    
    .tab-btn {
      font-size: 1rem;
      white-space: nowrap;
    }
    
    .tabs-header {
      justify-content: flex-start;
    }
  }
</style>

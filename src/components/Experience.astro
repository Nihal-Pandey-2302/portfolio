---
import type { EducationItem, ExperienceItem } from "../types";
import { rich } from "../utils/rich";
import Arrow from "../icons/Arrow.astro";

export interface Props {
  experience: ExperienceItem[];
  education: EducationItem;
}

const { experience, education } = Astro.props;
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<div class="roles">
  {experience.map((item) => (
    <article class="role">
      <p class="role-when">
        <span>{item.startDate} – {item.endDate}</span>
        <span class="text-faint">{item.location}</span>
      </p>
      <div class="role-body">
        <h3 class="role-company">
          {item.url ? (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="out">{item.company}<Arrow /></a>
          ) : (
            item.company
          )}
        </h3>
        <p class="role-position">{item.position}</p>

        {item.products && (
          <ul class="products">
            {item.products.map((product) => (
              <li>
                <a href={product.url} target="_blank" rel="noopener noreferrer" class="panel product">
                  <span class="product-top">
                    <span class="product-name">{product.name}</span>
                    <span class="product-status">{product.status}</span>
                  </span>
                  <span class="product-summary">{product.summary}</span>
                  <span class="out">{host(product.url)}<Arrow /></span>
                </a>
              </li>
            ))}
          </ul>
        )}

        <ul class="points">
          {item.summary.map((point) => <li set:html={rich(point)} />)}
        </ul>
      </div>
    </article>
  ))}

  <article class="role">
    <p class="role-when"><span>{education.years}</span></p>
    <div class="role-body">
      <h3 class="role-company">{education.degree}</h3>
      <p class="role-position">{education.school}</p>
    </div>
  </article>
</div>

<style>
  .role {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding: 2.25rem 0;
    border-top: 1px solid var(--color-border);
  }

  .role:first-child {
    padding-top: 0;
    border-top: none;
  }

  .role:last-child {
    padding-bottom: 0;
  }

  .role-when {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.2rem;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .role-company {
    font-size: 1.25rem;
  }

  .role-company :global(.out) {
    font-size: inherit;
    color: var(--color-text-main);
  }

  .role-position {
    margin-top: 0.2rem;
    color: var(--color-text-muted);
  }

  .points {
    margin-top: 1.25rem;
    max-width: 42rem;
  }

  /* ── Product tiles ───────────────────────────── */
  .products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 1.4rem;
  }

  .product {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.1rem 1.2rem 1rem;
    transition: border-color 0.15s ease;
  }

  .product:hover {
    border-color: var(--color-border-strong);
  }

  .product-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .product-name {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .product-status {
    font-size: var(--text-tiny);
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  .product-summary {
    flex-grow: 1;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .product .out {
    font-size: var(--text-tiny);
  }

  @media (max-width: 700px) {
    .role {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.75rem 0;
    }

    .role-when {
      flex-direction: row;
      gap: 0.9rem;
      padding-top: 0;
    }

    .products {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

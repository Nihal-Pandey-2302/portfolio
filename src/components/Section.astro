---
// A page section: title (and an optional line under it) in the left column,
// content on the right. The title column sticks while the section scrolls.
interface Props {
  id: string;
  title: string;
  lede?: string;
}

const { id, title, lede } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <div class="section-grid">
      <header class="section-head">
        <h2 class="section-title">{title}</h2>
        {lede && <p class="section-lede">{lede}</p>}
      </header>
      <div class="section-body">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .section-grid {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 2rem 3.5rem;
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-border);
  }

  .section-head {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    align-self: start;
  }

  .section-title {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .section-lede {
    margin-top: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-text-faint);
  }

  .section-body {
    min-width: 0;
  }

  @media (max-width: 960px) {
    .section-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .section-head {
      position: static;
    }
  }
</style>

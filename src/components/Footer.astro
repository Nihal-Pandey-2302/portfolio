---
import { SITE_CONFIG } from "@config";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container flex flex-col items-center">
    <div class="availability-banner mb-lg">
      <div class="status-row flex items-center gap-xs mb-xs justify-center">
        <span class="status-indicator"></span>
        <p class="text-main font-bold">Open to Full-Time Opportunities | Available May 2026</p>
      </div>
      <p class="text-muted text-sm text-center">Interested in: Rust Backend • Protocol Engineering • Blockchain Infrastructure • Security Systems</p>
    </div>

    <div class="social-links flex gap-sm">
      {
        SITE_CONFIG.socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="social-link mono">
            {link.text}
          </a>
        ))
      }
    </div>
    <p class="copyright text-muted mono">
      &copy; {currentYear} {SITE_CONFIG.author}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xl);
    background: var(--color-bg-secondary);
  }

  .social-links {
    margin-bottom: var(--space-sm);
  }

  .social-link {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .social-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-dim);
  }

  .copyright {
    font-size: 0.8rem;
  }

  .availability-banner {
    background: rgba(0, 255, 163, 0.05);
    border: 1px solid rgba(0, 255, 163, 0.2);
    padding: var(--space-md) var(--space-lg);
    border-radius: 8px;
    width: 100%;
    max-width: 600px;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-accent);
    display: inline-block;
  }
</style>

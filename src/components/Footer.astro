---
import { SITE_CONFIG, SITE_CONTENT } from "@config";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container flex flex-col items-center">
    <div class="footer-content text-center">
      <div class="social-links flex justify-center gap-md mb-md">
        {SITE_CONFIG.socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="social-link mono text-muted hover-text-accent">
            {link.text}
          </a>
        ))}
      </div>

      <p class="copyright text-muted mono">
        &copy; {new Date().getFullYear()} {SITE_CONTENT.hero.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xl);
    background: var(--color-bg-secondary);
  }

  .social-links {
    margin-bottom: var(--space-sm);
  }

  .social-link {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .social-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-dim);
  }

  .copyright {
    font-size: 0.8rem;
  }

  .availability-banner {
    background: rgba(52, 211, 153, 0.05);
    border: 1px solid rgba(52, 211, 153, 0.2);
    padding: var(--space-md) var(--space-lg);
    border-radius: 8px;
    width: 100%;
    max-width: 600px;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-accent);
    display: inline-block;
  }
</style>

---
import { SITE_CONFIG } from "@config";

export interface Props {
  name: string;
  specialty: string;
  summary: string;
}

const { name, specialty, summary } = Astro.props;

const github = SITE_CONFIG.socialLinks.find((l) => l.text === "Github");
const linkedin = SITE_CONFIG.socialLinks.find((l) => l.text === "LinkedIn");
---

<section id="hero" class="hero-section flex items-center">
  <div class="container">
    <div class="hero-content animate-fade-in">
      <h1 class="name">{name}</h1>
      <h2 class="specialty mono text-accent">{specialty}</h2>
      <p class="hero-summary text-muted">
        {summary}
      </p>

      <div class="hero-actions flex gap-sm" style="flex-wrap: wrap;">
        <a href="#projects" class="btn btn-primary">
          See What I'm Building
        </a>
        {github && (
          <a href={github.href} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            GitHub
          </a>
        )}
        {linkedin && (
          <a href={linkedin.href} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            LinkedIn
          </a>
        )}
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          Resume
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: calc(var(--header-height) + 6rem);
    padding-bottom: 3rem;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: calc(var(--header-height) + 2.5rem);
      padding-bottom: 1.5rem;
    }
  }

  .hero-content {
    max-width: 900px;
  }

  .name {
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 1.1;
    margin-bottom: var(--space-xs);
    background: linear-gradient(to right, #fff, #a0a0a0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .specialty {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: var(--space-md);
    opacity: 0.9;
  }

  .hero-summary {
    font-size: 1.05rem;
    margin-bottom: var(--space-md);
    max-width: 640px;
    line-height: 1.75;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.5rem;
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    transition: all 0.2s ease;
    font-family: var(--font-sans); /* Use sans-serif for cleaner look */
    text-decoration: none;
    line-height: 1;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg);
    border: 1px solid var(--color-accent);
  }

  .btn-primary:hover {
    background: transparent;
    color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(var(--color-accent-rgb), 0.15);
    transform: translateY(-1px);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-text-main);
  }

  .btn-outline:hover {
    border-color: var(--color-text-main);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-1px);
  }

</style>

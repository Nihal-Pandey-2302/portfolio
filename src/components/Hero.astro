---
import { SITE_CONFIG } from "@config";
import type { HeroContent } from "../types";
import { rich } from "../utils/rich";
import Arrow from "../icons/Arrow.astro";
import Map from "./Map.astro";

export interface Props {
  hero: HeroContent;
}

const { hero } = Astro.props;
---

<!-- #about is kept as a target for links to the old About section -->
<section id="hero" class="hero">
  <span id="about"></span>
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="hero-role">{hero.role}</p>

      <h1 class="hero-headline">{hero.headline}</h1>

      <div class="hero-summary">
        {hero.summary.map((paragraph) => <p set:html={rich(paragraph)} />)}
      </div>

      <div class="hero-actions">
        <a href="#contact" class="btn">Get in touch</a>
        <ul class="hero-links">
          {SITE_CONFIG.socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="out">
                {link.text}<Arrow />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- An overview before the detail: where the work below sits around Postgres -->
    <Map stops={hero.map} />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero-role {
    margin-bottom: 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .hero-headline {
    margin-bottom: 1.75rem;
    font-size: clamp(2.1rem, 1.15rem + 2.9vw, 3.35rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .hero-summary {
    display: grid;
    gap: 0.9rem;
    max-width: 33rem;
    margin-bottom: 2.25rem;
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .btn {
    padding: 0.7rem 1.15rem;
    border-radius: 9px;
    background: var(--color-text-main);
    color: var(--color-bg);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1;
    transition: opacity 0.15s ease;
  }

  .btn:hover {
    opacity: 0.86;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

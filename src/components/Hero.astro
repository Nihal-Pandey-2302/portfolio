---
import { SITE_CONTENT } from "@config";

export interface Props {
  name: string;
  specialty: string;
  summary: string;
  email: string;
}

const { name } = Astro.props;
---

<section id="hero" class="hero-section flex items-center">
  <div class="container">
    <div class="hero-content animate-fade-in">
      <h1 class="name">{name}</h1>
      <h2 class="specialty mono text-accent">{SITE_CONTENT.hero.specialty}</h2>
      <p class="hero-summary text-muted">
        {SITE_CONTENT.hero.summary}
      </p>

      <div class="hero-actions flex gap-sm" style="flex-wrap: wrap;">
        <a href="#projects" class="btn btn-primary">
          See What I'm Building
        </a>
        <a href="https://github.com/Nihal-Pandey-2302" target="_blank" class="btn btn-outline">
          GitHub
        </a>
        <a href="https://www.linkedin.com/in/nihal-pandey-8529b6257/" target="_blank" class="btn btn-outline">
          LinkedIn
        </a>
      </div>


    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: calc(var(--header-height) + 6rem);
    padding-bottom: 3rem;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: calc(var(--header-height) + 2.5rem);
      padding-bottom: 1.5rem;
    }
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 900px;
  }

  .greeting {
    font-size: 1.2rem;
    margin-bottom: var(--space-xs);
  }

  .name {
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 1.1;
    margin-bottom: var(--space-xs);
    background: linear-gradient(to right, #fff, #a0a0a0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .specialty {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 500;
    color: var(--color-text-main);
    border-bottom: none;
    margin-bottom: var(--space-md);
    opacity: 0.9;
  }

  .hero-summary {
    font-size: 1.05rem;
    margin-bottom: var(--space-md);
    max-width: 640px;
    line-height: 1.75;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.5rem;
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    transition: all 0.2s ease;
    font-family: var(--font-sans); /* Use sans-serif for cleaner look */
    text-decoration: none;
    line-height: 1;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg);
    border: 1px solid var(--color-accent);
  }

  .btn-primary:hover {
    background: transparent;
    color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(52, 211, 153, 0.15);
    transform: translateY(-1px);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-text-main);
  }

  .btn-outline:hover {
    border-color: var(--color-text-main);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-1px);
  }

</style>

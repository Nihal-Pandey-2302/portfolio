---
---

<section id="seeking" class="section-padding">
  <div class="container">
    <div class="seeking-card animate-fade-in" style="animation-delay: 0.2s;">
      <div class="header-row">
        <h2 class="seeking-title mono">Current Status</h2>
        <div class="status-indicator">
          <span class="pulsing-dot"></span>
          <span class="status-text text-accent">Open to Work</span>
        </div>
      </div>

      <div class="content-grid">
        <div class="main-focus">
          <h3 class="role-title">Backend Engineer</h3>
          <p class="role-desc text-muted">Focused on high-performance distributed systems, rust infrastructure, and real-time data pipelines.</p>
        </div>

        <div class="details-grid">
          <div class="detail-item">
            <span class="label mono text-muted">Availability</span>
            <span class="value text-accent">Immediate Start</span>
          </div>
          
          <div class="detail-item">
            <span class="label mono text-muted">Type</span>
            <span class="value">Remote / Contract</span>
          </div>

          <div class="detail-item">
            <span class="label mono text-muted">Stack</span>
            <span class="value">Rust • Postgres • AWS</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-padding {
    padding: var(--space-lg) 0;
  }

  .seeking-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-md);
    position: relative;
    overflow: hidden;
  }

  .seeking-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-accent);
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .seeking-title {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 255, 163, 0.1);
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid rgba(0, 255, 163, 0.2);
  }

  .pulsing-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .status-text {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-lg);
  }

  .role-title {
    font-size: 1.8rem;
    margin-bottom: var(--space-xs);
    color: var(--color-text-main);
  }

  .role-desc {
    font-size: 1rem;
    line-height: 1.6;
    max-width: 90%;
  }

  .details-grid {
    display: grid;
    gap: var(--space-sm);
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .value {
    font-size: 1rem;
    color: var(--color-text-main);
    font-weight: 500;
  }

  @keyframes pulse {
    0% { opacity: 1; box-shadow: 0 0 0 0 rgba(0, 255, 163, 0.4); }
    70% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(0, 255, 163, 0); }
    100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0, 255, 163, 0); }
  }

  @media (max-width: 768px) {
    .content-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .role-desc {
      max-width: 100%;
    }
  }
</style>

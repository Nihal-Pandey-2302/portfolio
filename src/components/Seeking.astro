---
---

<section id="seeking" class="section-padding">
  <div class="container">
    <div class="seeking-card">
      <div class="card-content">
        <div class="header-row">
          <div class="status-badge">
            <span class="pulse-dot"></span>
            <span class="status-text mono">Current Status: Open to Work</span>
          </div>
        </div>

        <div class="main-info">
          <h2 class="role-title">Blockchain and Backend Engineer</h2>
          <p class="role-description">
            Solana programs, Node.js backend infrastructure, Rust systems, and EVM smart contracts.
          </p>
        </div>

        <div class="meta-grid mono">
          <div class="meta-item">
            <span class="label text-muted">Availability</span>
            <span class="value text-accent">Immediate Start</span>
          </div>
          <div class="meta-item">
            <span class="label text-muted">Type</span>
            <span class="value">Remote / Contract</span>
          </div>
          <div class="meta-item">
            <span class="label text-muted">Stack</span>
            <span class="value">Rust · Solana · Node.js · TypeScript</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-padding {
    padding: var(--space-lg) 0;
  }

  .seeking-card {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-lg);
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  /* Distinct "System" look */
  .seeking-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-accent);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 255, 163, 0.1);
    padding: 6px 12px;
    border-radius: 20px;
    border: 1px solid rgba(0, 255, 163, 0.2);
    margin-bottom: var(--space-md);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-accent);
    animation: pulse 2s infinite;
  }

  .status-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .role-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
    color: var(--color-text-main);
  }

  .role-description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin-bottom: var(--space-lg);
    line-height: 1.6;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-md);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .value {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-main);
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.7; }
    100% { transform: scale(1); opacity: 1; }
  }

  @media (max-width: 600px) {
    .seeking-card {
      padding: var(--space-md);
    }
    
    .role-title {
      font-size: 1.5rem;
    }
    
    .meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

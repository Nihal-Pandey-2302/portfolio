---
import { SITE_CONFIG } from "@config";
import Arrow from "../icons/Arrow.astro";

export interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div class="contact">
  <p class="contact-text">
    Email is the fastest way to reach me. Happy to talk backend architecture, PostgreSQL internals, email infrastructure, or open source.
  </p>

  <p class="contact-line">
    <a href={`mailto:${email}`} class="email-link">{email}</a>
    <button type="button" class="copy-btn" id="copy-email" data-email={email}>Copy</button>
  </p>

  <ul class="contact-links">
    {SITE_CONFIG.socialLinks.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="out">{link.text}<Arrow /></a>
      </li>
    ))}
  </ul>
</div>

<script>
  const copyBtn = document.getElementById('copy-email');
  copyBtn?.addEventListener('click', async () => {
    const original = copyBtn.textContent;
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.email ?? '');
      copyBtn.textContent = 'Copied';
    } catch {
      // clipboard blocked (permissions, insecure context): the address is still on screen to select
      copyBtn.textContent = 'Copy failed';
    }
    setTimeout(() => { copyBtn.textContent = original; }, 1600);
  });
</script>

<style>
  .contact-text {
    max-width: 34rem;
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .contact-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin: 1.75rem 0 2rem;
  }

  .email-link {
    font-size: clamp(1.35rem, 0.9rem + 2.2vw, 2.25rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--color-border-strong);
    transition: border-color 0.15s ease;
  }

  .email-link:hover {
    border-bottom-color: currentColor;
  }

  .copy-btn {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    font-size: var(--text-tiny);
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .copy-btn:hover {
    color: var(--color-text-main);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>

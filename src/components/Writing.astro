---
import type { WritingItem } from "../types";
import Arrow from "../icons/Arrow.astro";

export interface Props {
  writing: WritingItem[];
}

const { writing } = Astro.props;
---

<div class="posts">
  {writing.map((item) => {
    const published = item.status === "published";
    const Wrapper = published ? "a" : "div";
    return (
      <Wrapper
        class:list={["post", { "post-upcoming": !published }]}
        href={item.link}
        target={published ? "_blank" : undefined}
        rel={published ? "noopener noreferrer" : undefined}
      >
        <div class="post-body">
          <h3 class="post-title">{item.title}</h3>
          <p class="post-summary">{item.summary}</p>
          {item.badge && <p class="post-badge">{item.badge}</p>}
        </div>
        {published ? (
          <span class="out">Read<Arrow /></span>
        ) : (
          <span class="post-status">In progress</span>
        )}
      </Wrapper>
    );
  })}
</div>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.4rem 2rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-border);
  }

  .post:first-child {
    padding-top: 0;
    border-top: none;
  }

  .post-title {
    margin-bottom: 0.35rem;
    font-size: 1.125rem;
  }

  .post-summary {
    max-width: 40rem;
    color: var(--color-text-muted);
  }

  .post-badge {
    margin-top: 0.5rem;
    font-size: var(--text-tiny);
    color: var(--color-text-faint);
  }

  a.post:hover .post-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a.post:hover .out {
    color: var(--color-text-main);
  }

  /* not yet readable: stepped back, and no hover affordance */
  .post-upcoming .post-title {
    color: var(--color-text-muted);
  }

  .post-status {
    font-size: var(--text-small);
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "@config";
---

<Layout title={`404 | ${SITE_CONFIG.author}`} description="Page not found.">
  <section class="not-found">
    <div class="container">
      <p class="mono text-faint">404</p>
      <h1 class="title">Page not found</h1>
      <p class="text-muted">
        This page doesn't exist. It may have moved with a site update.
      </p>
      <p><a href="/" class="link">Back to the homepage</a></p>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  .not-found .container {
    display: grid;
    gap: 1rem;
  }

  .title {
    font-size: clamp(2.1rem, 1.15rem + 2.9vw, 3.35rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
</style>

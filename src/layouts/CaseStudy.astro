---
// Frame for a /work/* case study: back link, title block, facts, then the story.
import Layout from "./Layout.astro";
import { SITE_CONFIG } from "@config";
import Arrow from "../icons/Arrow.astro";
import "../styles/case-study.css";

export interface Props {
  title: string;
  dek: string;
  // the pull request the story is about...
  pr?: { ref: string; url: string; merged: string; additions: number; deletions: number; files: number };
  issue?: { ref: string; url: string };
  // ...or, for a project of its own, its facts and where its source lives
  meta?: { text: string; href?: string }[];
  source?: { label: string; url: string };
  // another case study to read next
  next?: { title: string; href: string };
}

const { title, dek, pr, issue, meta, source, next } = Astro.props;
const external = source ?? (pr && { label: "The full pull request on GitHub", url: pr.url });
---

<Layout title={`${title} | ${SITE_CONFIG.author}`} description={dek}>
  <div class="container">
    <article class="cs-page">
      <a href="/#open-source" class="cs-back">Back to open source</a>

      <h1 class="cs-title">{title}</h1>
      <p class="cs-tagline">{dek}</p>

      {pr && <p class="cs-chips">
        <span class="cs-chip">
          <a href={pr.url} target="_blank" rel="noopener noreferrer" class="link">paradedb {pr.ref}</a>
        </span>
        <span class="cs-chip">merged {pr.merged}</span>
        <span class="cs-chip">
          <span class="cs-add">+{pr.additions}</span> <span class="cs-del">−{pr.deletions}</span> in {pr.files} files
        </span>
        {issue && (
          <span class="cs-chip">
            <a href={issue.url} target="_blank" rel="noopener noreferrer" class="link">issue {issue.ref}</a>
          </span>
        )}
      </p>}
      {meta && (
        <p class="cs-chips">
          {meta.map((item) => (
            <span class="cs-chip">
              {item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer" class="link">{item.text}</a> : item.text}
            </span>
          ))}
        </p>
      )}

      <slot />

      <p class="cs-next">
        {external && <a href={external.url} target="_blank" rel="noopener noreferrer" class="out">{external.label}<Arrow /></a>}
        {next && <a href={next.href} class="link">Next: {next.title}</a>}
      </p>
    </article>
  </div>
</Layout>
